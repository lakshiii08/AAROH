# Environment Configuration for AAROH
APP_ENV=development
LOG_LEVEL=INFO

# AWS Credentials and Region
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=

# AWS S3 Configuration
S3_RAW_BUCKET=aaroh-raw-lessons-storage
S3_PROCESSED_BUCKET=aaroh-processed-lessons-storage

# PostgreSQL with pgvector (AWS RDS)
DB_DIALECT=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aaroh_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_USE_SQLITE_FALLBACK=true

# AWS Bedrock Models
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
ENABLE_MOCK_LLM_FALLBACK=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
