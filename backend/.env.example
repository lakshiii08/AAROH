# AAROH Backend Environment Configuration
# Copy to .env for local development, or set these in your deployment platform.

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Use "*" only for local development. Production must list explicit origins.
# Example: CORS_ORIGINS=https://app.example.com,https://teacher.example.com
CORS_ORIGINS=*

# MongoDB - authentication and identity database.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=aaroh_auth_db
MONGODB_USE_MOCK_FALLBACK=true

# PostgreSQL - curriculum, assessment, vector, and learning data.
# For production, set DATABASE_URL or provide all POSTGRES_* values and disable SQLite fallback.
DATABASE_URL=
POSTGRES_USER=aaroh_admin
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aaroh_learning_db
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=data/aaroh_backend.db

# JWT authentication.
# Leave blank in local development to generate an ephemeral startup secret.
# Production must set a long random value, e.g. output from: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo access. Disable in production if public demo accounts are not wanted.
ENABLE_DEMO_LOGINS=true
DEMO_SCHOOL_ID=SCH_DEMO_01
DEMO_SCHOOL_CODE=DEMO01
DEMO_DISTRICT_ID=DIST_DEMO_01
DEMO_TEACHER_LOGIN=teacher@123
DEMO_TEACHER_PASSWORD=teacher@123
DEMO_STUDENT_ROLL_NUMBER=24
DEMO_STUDENT_PASSWORD=1234

# Aaroh-AI core integration.
# Runtime path inside the deployed container. Leave blank locally unless overriding discovery.
AAROH_AI_PATH=
# Docker build source for Render and other backend-only deploys.
AAROH_AI_REPO_URL=https://github.com/Pahuja07/Aaroh-AI.git
AAROH_AI_REF=main

# Cloud and AI providers. Optional unless the selected pipeline requires them.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
TRANSLATION_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# Storage.
S3_ENDPOINT=
S3_BUCKET=aaroh-content-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
LOCAL_STORAGE_DIR=data/storage

# Cache and queues.
REDIS_URL=
